{
  "name": "@fuse/infra",
  "private": true,
  "version": "0.0.0",
  "description": "Fuse AWS CDK app. Synthesize only in C1.4. Do not deploy until region and credentials are verified.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
