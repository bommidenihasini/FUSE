    "synth": "tsc -p tsconfig.json && cdk synth",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1142.0"
  }
}
