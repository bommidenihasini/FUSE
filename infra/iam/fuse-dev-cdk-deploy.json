{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyBedrockInvocation",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBroadIamAndAdmin",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy",
        "iam:PutUserPolicy",
        "iam:DeleteUserPolicy",
        "iam:AddUserToGroup",
        "iam:CreateLoginProfile",
        "iam:CreatePolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AssumeCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::843447460827:role/cdk-hnb659fds-deploy-role-843447460827-us-east-1",
        "arn:aws:iam::843447460827:role/cdk-hnb659fds-file-publishing-role-843447460827-us-east-1",
        "arn:aws:iam::843447460827:role/cdk-hnb659fds-image-publishing-role-843447460827-us-east-1",
        "arn:aws:iam::843447460827:role/cdk-hnb659fds-lookup-role-843447460827-us-east-1"
      ]
    },
    {
      "Sid": "ReadCdkBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:843447460827:parameter/cdk-bootstrap/hnb659fds/version"
    },
    {
      "Sid": "CloudFormationFuseAndToolkit",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStackResourceDrifts",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ListStackResources"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:843447460827:stack/FuseMvp/*",
        "arn:aws:cloudformation:us-east-1:843447460827:stack/CDKToolkit/*"
      ]
    },
    {
      "Sid": "CloudFormationListStacks",
      "Effect": "Allow",
      "Action": ["cloudformation:ListStacks", "cloudformation:DescribeStacks"],
      "Resource": "*"
    },
    {
      "Sid": "CdkAssetBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-843447460827-us-east-1",
        "arn:aws:s3:::cdk-hnb659fds-assets-843447460827-us-east-1/*",
        "arn:aws:s3:::fusemvp-*",
        "arn:aws:s3:::fusemvp-*/*"
      ]
    },
    {
      "Sid": "PassOnlyFuseAndCdkRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::843447460827:role/FuseMvp-*",
        "arn:aws:iam::843447460827:role/cdk-hnb659fds-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "edgelambda.amazonaws.com",
            "apigateway.amazonaws.com",
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ManageFuseStackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::843447460827:role/FuseMvp-*",
        "arn:aws:iam::843447460827:role/cdk-hnb659fds-*"
      ]
    },
    {
      "Sid": "LambdaFuseFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListFunctions",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:InvokeFunction",
        "lambda:PublishVersion",
        "lambda:GetPolicy"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:843447460827:function:FuseMvp-*",
        "arn:aws:lambda:us-east-1:843447460827:function:FuseControlFn*",
        "arn:aws:lambda:us-east-1:843447460827:function:FuseRunnerFn*"
      ]
    },
    {
      "Sid": "ApiGatewayHttpApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis",
        "arn:aws:apigateway:us-east-1::/apis/*",
        "arn:aws:apigateway:us-east-1::/tags/*"
      ]
    },
    {
      "Sid": "DynamoDbFuseTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:ListTables"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:843447460827:table/FuseMvp-*",
        "arn:aws:dynamodb:us-east-1:843447460827:table/FuseRuns*",
        "arn:aws:dynamodb:us-east-1:843447460827:table/FuseEvents*"
      ]
    },
    {
      "Sid": "EventBridgeFuseBus",
      "Effect": "Allow",
      "Action": [
        "events:DescribeEventBus",
        "events:CreateEventBus",
        "events:PutPermission",
        "events:ListTagsForResource",
        "events:TagResource",
        "events:UntagResource",
        "events:PutRule",
        "events:DescribeRule",
        "events:PutTargets",
        "events:ListTargetsByRule"
      ],
      "Resource": [
        "arn:aws:events:us-east-1:843447460827:event-bus/fuse-breaker",
        "arn:aws:events:us-east-1:843447460827:event-bus/FuseMvp-*",
        "arn:aws:events:us-east-1:843447460827:rule/fuse-breaker/*",
        "arn:aws:events:us-east-1:843447460827:rule/FuseMvp-*"
      ]
    },
    {
      "Sid": "CloudWatchLogsFuse",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:ListTagsLogGroup",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:PutResourcePolicy",
        "logs:DescribeResourcePolicies"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:843447460827:log-group:/aws/lambda/FuseMvp-*",
        "arn:aws:logs:us-east-1:843447460827:log-group:/aws/lambda/FuseMvp-*:*",
        "arn:aws:logs:us-east-1:843447460827:log-group:/aws/http-api/*",
        "arn:aws:logs:us-east-1:843447460827:log-group:*Fuse*"
      ]
    },
    {
      "Sid": "CloudFrontDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
